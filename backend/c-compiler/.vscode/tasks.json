{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Tricora",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Tricora example",
      "type": "shell",
      "command": "./build/tricora --all examples/valid/manual_sample.tri",
      "dependsOn": "Build Tricora",
      "problemMatcher": []
    }
  ]
}

