// C style (bonus): printf without <stdio.h> (reported once), conversions that do not
// match their arguments, too few arguments, an unsupported conversion, and main
// returning a float.
int main() {
    int x = 1;
    float f = 2.0;
    printf("%d\n", f);
    printf("%f\n", x);
    printf("%d %d\n", x);
    printf("%s\n", x);
    return 1.5;
}
