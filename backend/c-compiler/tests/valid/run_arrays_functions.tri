// flags: --run
// Bonus: arrays, functions with parameters, return values, recursion and
// a global array shared by functions.
#include <stdio.h>

int data[6] = {5, 2, 9, 1, 7, 3};

int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

float average(int count) {
    int total = 0;
    for (int i = 0; i < count; i++) {
        total += data[i];
    }
    return total / 1.0 / count;
}

void sort(int count) {
    for (int i = 0; i < count - 1; i++) {
        for (int j = 0; j < count - 1 - i; j++) {
            if (data[j] > data[j + 1]) {
                int swap = data[j];
                data[j] = data[j + 1];
                data[j + 1] = swap;
            }
        }
    }
}

bool is_even(int n) {
    return n % 2 == 0;
}

int main() {
    printf("5! = %d\n", factorial(5));
    printf("fib(10) = %d\n", fib(10));
    printf("average = %.2f\n", average(6));
    sort(6);
    for (int i = 0; i < 6; i++) {
        printf("%d ", data[i]);
    }
    printf("\n");
    int squares[5];
    for (int i = 0; i < 5; i++) {
        squares[i] = i * i;
    }
    squares[4]++;
    printf("squares[4] = %d, even? %d\n", squares[4], is_even(squares[4]));
    return 0;
}
