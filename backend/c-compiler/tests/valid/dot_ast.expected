exit 0
digraph AST {
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
    edge [arrowsize=0.7];
    n0 [label="Program", fillcolor="#d9d2e9"];
    n1 [label="VarDecl int x (line 3)", fillcolor="#cfe2f3"];
    n0 -> n1;
    n2 [label="IntLiteral 3", fillcolor="#ffffff"];
    n1 -> n2;
    n3 [label="While (line 4)", fillcolor="#fce5cd"];
    n0 -> n3;
    n4 [label="Condition", fillcolor="#f3f3f3"];
    n3 -> n4;
    n5 [label="BinaryOp >", fillcolor="#fff2cc"];
    n4 -> n5;
    n6 [label="Identifier x", fillcolor="#ffffff"];
    n5 -> n6;
    n7 [label="IntLiteral 0", fillcolor="#ffffff"];
    n5 -> n7;
    n8 [label="Body", fillcolor="#f3f3f3"];
    n3 -> n8;
    n9 [label="Block (line 4)", fillcolor="#f3f3f3"];
    n8 -> n9;
    n10 [label="Decrement x (line 5)", fillcolor="#d9ead3"];
    n9 -> n10;
    n11 [label="Print (line 7)", fillcolor="#f3f3f3"];
    n0 -> n11;
    n12 [label="Identifier x", fillcolor="#ffffff"];
    n11 -> n12;
}
