// flags: --run
// Bonus loops: for, do-while, switch with fall-through, break, continue,
// ++ / -- and compound assignment.
int sum = 0;
for (int i = 1; i <= 10; i++) {
    if (i % 2 == 0) {
        continue;            // skip even numbers
    }
    sum += i;
}
print sum;                   // 1 + 3 + 5 + 7 + 9 = 25

int n = 5;
int fact = 1;
do {
    fact *= n;
    n--;
} while (n > 0);
print fact;                  // 120

int k = 0;
for (;;) {                   // no condition: stops with break
    k++;
    if (k == 4) {
        break;
    }
}
print k;                     // 4

for (int day = 1; day <= 4; day++) {
    switch (day) {
    case 1:
        print 100;
        break;
    case 2:
    case 3:                  // 2 falls through to 3
        print 200;
        break;
    default:
        print -1;
    }
}

float x = 1.5;
x += 2;
x *= 2.0;
print x;                     // 7
