func factorial:
    formal n
    t21 = n <= 1
    ifFalse t21 goto L8
    return 1
L8:
    t22 = n - 1
    param t22
    t23 = call factorial 1
    t24 = n * t23
    return t24
    endfunc
func fib:
    formal n_1
    t25 = n_1 < 2
    ifFalse t25 goto L9
    return n_1
L9:
    t26 = n_1 - 1
    param t26
    t27 = call fib 1
    t28 = n_1 - 2
    param t28
    t29 = call fib 1
    t30 = t27 + t29
    return t30
    endfunc
func average:
    formal count
    total = 0
    i = 0
L10:
    t31 = i < count
    ifFalse t31 goto L11
    t32 = data[i]
    t33 = total + t32
    total = t33
    t34 = i + 1
    i = t34
    goto L10
L11:
    t35 = (float) total
    t36 = t35 / 1.0
    t37 = (float) count
    t38 = t36 / t37
    return t38
    endfunc
func sortData:
    formal count_1
    i_1 = 0
L13:
    t39 = count_1 - 1
    t40 = i_1 < t39
    ifFalse t40 goto L14
    j = 0
L16:
    t41 = count_1 - 1
    t42 = t41 - i_1
    t43 = j < t42
    ifFalse t43 goto L17
    t44 = data[j]
    t45 = j + 1
    t46 = data[t45]
    t47 = t44 > t46
    ifFalse t47 goto L19
    t48 = data[j]
    swap = t48
    t49 = j + 1
    t50 = data[t49]
    data[j] = t50
    t51 = j + 1
    data[t51] = swap
L19:
    t52 = j + 1
    j = t52
    goto L16
L17:
    t53 = i_1 + 1
    i_1 = t53
    goto L13
L14:
    endfunc
func scale:
    formal x
    formal times
    t54 = (float) times
    t55 = x * t54
    return t55
    endfunc
