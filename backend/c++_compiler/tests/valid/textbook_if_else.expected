=== Headers ===
Header              Line  Category      Role in this compiler
------------------------------------------------------------------------
<iostream>          2     I/O           enables cout / endl  - std::cout / std::cin streams
=== Three Address Code ===
    outs "Enter an integer: "
    read number
    t1 = number > 0
    ifFalse t1 goto L1
    outs "You entered a positive number.\n"
    goto L2
L1:
    t2 = number < 0
    ifFalse t2 goto L3
    outs "You entered a negative number.\n"
    goto L4
L3:
    outs "You entered zero.\n"
L4:
L2:
    goto L5
L5:
=== Optimized TAC ===
    outs "Enter an integer: "
    read number
    t1 = number > 0
    ifFalse t1 goto L1
    outs "You entered a positive number.\n"
    goto L2
L1:
    t2 = number < 0
    ifFalse t2 goto L3
    outs "You entered a negative number.\n"
    goto L4
L3:
    outs "You entered zero.\n"
L4:
L2:
=== Program Output ===
Enter an integer: You entered a negative number.
