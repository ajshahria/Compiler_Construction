# One ignore file for the whole repository (all three compilers).
# Each compiler builds into its own build/ folder with `make`; nothing
# generated by make, the compilers or the GUIs is committed.

# ----- build output (generated parser/lexer sources, objects, executables) -----
build/
*.o
*.obj
*.exe
lex.yy.c
lex.yy.cpp
parser.tab.c
parser.tab.cpp
parser.tab.h
parser.tab.hpp
parser.output

# ----- compiler output files -----
*.tac
*.asm
*.s
# written by the MiniJava compiler with --emit-files
backend/javacompiler/ast.txt
backend/javacompiler/symbols.txt

# ----- Python (web UI server) -----
__pycache__/
*.py[cod]

# ----- editors and operating systems -----
.DS_Store
Thumbs.db
*.swp
*.swo

# ----- web UI (frontend/ and server/) -----
node_modules/
frontend/dist/
*.tsbuildinfo
.venv/
